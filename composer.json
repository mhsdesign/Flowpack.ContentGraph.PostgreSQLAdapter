{
    "name": "flowpack/contentgraph-postgresqladapter",
    "type": "library",
    "description": "The PostgreSQL database backend for the Neos content graph",
    "support": {
        "source": "https://github.com/flowpack/contentgraph-postgresqladapter.git",
        "forum": "https://discuss.neos.io/",
        "docs": "https://docs.neos.io/"
    },
    "license": "GPL-3.0+",
    "require": {
        "neos/contentrepository-core": "~9.0",
        "doctrine/dbal": "^3.1.4",
        "doctrine/migrations": "*",
        "opensoft/doctrine-postgres-types": "1.3.1"
    },
    "autoload": {
        "psr-4": {
            "Flowpack\\ContentGraph\\PostgreSQLAdapter\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Flowpack\\ContentGraph\\PostgreSQLAdapter\\Tests\\": "Tests"
        }
    }
}
